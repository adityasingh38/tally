# Supabase — get from https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — get from https://app.revenuecat.com -> Project -> API Keys -> Public SDK key (Android)
# Leave empty to disable billing (free tier enforced in prod, unlocked in dev)
REVENUECAT_API_KEY=

# AI Provider — server-side only, for the Edge Function. Never bundled into the app.
# Get free Gemini API key: https://aistudio.google.com/app/apikey
# Deploy secret: supabase secrets set GEMINI_API_KEY=AIzaSy...
# Or use Anthropic: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# RevenueCat secret API key is also server-side only. Set it as a Supabase
# Edge Function secret named REVENUECAT_SECRET_API_KEY; never put it in EAS env.
